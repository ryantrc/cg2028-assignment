# Copy this file to .env and fill in the token. Never commit .env.
TELEGRAM_BOT_TOKEN=

# Use COM3 (Windows), /dev/ttyACM0 (Linux), /dev/cu.usbmodem* (macOS), AUTO, or SIMULATED.
SERIAL_PORT=AUTO
BAUD_RATE=115200

ACTIVITY_DATABASE_PATH=runtime/activity_readings.sqlite3
ACTIVITY_CSV_PATH=runtime/activity_readings.csv
BOT_DATABASE_PATH=runtime/telegram_bot.sqlite3

TRIGGER_EVENT=POSSIBLE_FALL
ALERT_COOLDOWN_SECONDS=30
SERIAL_RETRY_SECONDS=5
LOG_LEVEL=INFO

