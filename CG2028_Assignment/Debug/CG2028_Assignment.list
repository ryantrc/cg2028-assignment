@   R6-R7 = unused; preserved by the starter PUSH/POP
@
@ Write your program from here.
.thumb_func
ewma_filter:
    PUSH {r4-r7, lr}
 8000200:	b5f0      	push	{r4, r5, r6, r7, lr}

